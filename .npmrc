# pnpm configuration for Vercel deployment
# Fixes ERR_INVALID_THIS errors during build

# Disable pnpm's custom fetch implementation (use Node's native fetch)
use-node-version=18.17.0
node-linker=hoisted

# Fetch configuration
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=300000

# Disable strict peer dependencies to avoid conflicts
strict-peer-dependencies=false

# Use shamefully-hoist to flatten node_modules (helps with Vercel)
shamefully-hoist=true

# Enable public hoist pattern for better compatibility
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types/*

# Increase network timeout
network-timeout=300000

# Disable side effects cache (can cause issues on Vercel)
side-effects-cache=false
