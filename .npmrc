# pnpm configuration for Vercel deployment
# Fixes ERR_INVALID_THIS errors during build

# Use node's native fetch instead of pnpm's custom implementation
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Disable strict peer dependencies to avoid conflicts
strict-peer-dependencies=false

# Use shamefully-hoist to flatten node_modules (helps with Vercel)
shamefully-hoist=true

# Enable public hoist pattern for better compatibility
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types/*

# Increase network timeout
network-timeout=300000
